<section class="section contact-section" id="contact" data-section>
  <div class="contact-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="section-heading">
    <p class="eyebrow"><span>06</span> Start a project</p>
  </div>

  <div class="contact-layout">
    <div class="contact-copy">
      <h2 class="section-title reveal-text">Let's build<br/><em>something great.</em></h2>
      <p>Have an idea, project, or technical challenge? Tell us what you're imagining.</p>
      <div class="contact-details">
        <a href="mailto:hello@novaradigital.com"><span>Email</span>hello@novaradigital.com</a>
        <div><span>Social</span><b>LinkedIn · Instagram · GitHub</b></div>
      </div>
    </div>

    <form class="contact-form" name="contact" method="POST" data-contact-form>
      <label>
        <span>Name</span>
        <input type="text" name="name" placeholder="Your name" required />
      </label>
      <label>
        <span>Email</span>
        <input type="email" name="email" placeholder="you@email.com" required />
      </label>
      <label>
        <span>Subject</span>
        <input type="text" name="subject" placeholder="Project inquiry" />
      </label>
      <label>
        <span>Message</span>
        <textarea name="message" rows="4" placeholder="Tell us about your project" required></textarea>
      </label>
      <button class="button button-primary magnetic" type="submit"><span>Send inquiry</span><b>↗</b></button>
      <p class="form-status" role="status"></p>
    </form>
  </div>
</section>
